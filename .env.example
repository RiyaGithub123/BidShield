# =============================================================================
# BidShield — Privacy-Preserving Procurement on Midnight Network
# Environment Configuration Template
# =============================================================================
# Copy this file to .env before starting development:
#   cp .env.example .env
#
# INSTRUCTIONS ON HOW TO RETRIEVE EACH VARIABLE:
# -----------------------------------------------------------------------------
# 1. VITE_MIDNIGHT_NETWORK: Target Midnight network ('preprod', 'preview', 'testnet').
#    Preprod is the active developer network for Midnight Builder Challenge.
#
# 2. VITE_MIDNIGHT_RPC_URL: The JSON-RPC endpoint for Midnight Substrate node.
#    Preprod endpoint: https://rpc.preprod.midnight.network
#
# 3. VITE_INDEXER_URL: Midnight Indexer GraphQL endpoint for querying state.
#    Preprod endpoint: https://indexer.preprod.midnight.network/api/v4/graphql
#
# 4. VITE_INDEXER_WS_URL: WebSocket endpoint for realtime subscription events.
#    Preprod endpoint: wss://indexer.preprod.midnight.network/api/v4/graphql/ws
#
# 5. PROOF_SERVER_URL: Local Midnight Proof Server container endpoint.
#    Runs via `docker compose up -d` on port 6300.
#    Used by contract scripts for zero-knowledge witness proving.
#
# 6. VITE_CONTRACT_ADDRESS: The deployed BidShield contract address on Preprod.
#    Obtained by running `npm run deploy:contract`.
#
# 7. WALLET_SEED: 12 or 24-word BIP-39 mnemonic seed phrase for deployment wallet.
#    Generate with `npm run check-balance` or import from 1AM Wallet.
#    Fund with tNIGHT at https://midnight-tmnight-preprod.nethermind.dev
# =============================================================================

# Network Selection
VITE_MIDNIGHT_NETWORK=preprod

# Midnight Preprod Endpoints
VITE_MIDNIGHT_RPC_URL=https://rpc.preprod.midnight.network
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Proof Server (Local Docker container for ZK proving during deployment/testing)
PROOF_SERVER_URL=http://127.0.0.1:6300
PROOF_SERVER_PORT=6300

# Deployed BidShield Contract Addresses
VITE_PREPROD_CONTRACT_ADDRESS=fc67e2850565d285f2c51ece80eb4894a32961f317d91703f4cd98a9ebef088b
VITE_PREVIEW_CONTRACT_ADDRESS=0794f000c1446592b46446d9ce4929f43867dd86f5dc1660e25827ebaaf56123
VITE_CONTRACT_ADDRESS=fc67e2850565d285f2c51ece80eb4894a32961f317d91703f4cd98a9ebef088b

# Optional Mnemonic seed for deployment wallet script (never commit real seeds!)
# WALLET_SEED="word1 word2 word3 ... word24"

# Application Metadata
VITE_APP_NAME="BidShield"
VITE_APP_DESCRIPTION="Confidential Sealed-Bid Procurement on Midnight"
VITE_APP_URL=http://localhost:5173
