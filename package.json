{
  "name": "bidshield",
  "version": "0.1.0",
  "description": "BidShield — Privacy-Preserving Sealed-Bid Procurement & Auctions on Midnight Network",
  "private": true,
  "workspaces": [
    "contract",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "compile:contract": "npm run compile --prefix contract",
    "test:contract": "npm run test --prefix contract",
    "check-balance": "npm run check-balance --prefix contract",
    "deploy:contract": "npm run deploy --prefix contract",
    "network": "npm run network --prefix contract",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "keywords": [
    "midnight",
    "compact",
    "zero-knowledge",
    "zk-snarks",
    "privacy",
    "sealed-bid",
    "procurement",
    "auction",
    "commit-reveal",
    "confidentiality"
  ],
  "author": "RiyaGithub123 <chowdhuryriya59@gmail.com>",
  "license": "Apache-2.0"
}
